# Copia este archivo a backend/.env (NUNCA subas .env a git)
OPENAI_API_KEY=sk-...
# Opcional: servidor compatible con OpenAI (p. ej. un modelo local)
# OPENAI_BASE_URL=http://localhost:8000/v1
MODEL_AGENT=gpt-4.1-mini
MODEL_SMART=gpt-4.1
# Corte duro de gasto acumulado (data/runs/spend.json)
BUDGET_USD=20
# Precio por millón de tokens si el modelo no está en la tabla de core/llm.py (entrada,salida[,cache]).
# Sin precio, se cobra como gpt-4.1 (caro a propósito). Sin el tercer valor, la caché se cobra como entrada.
# PRICE_GPT_4_1_MINI=0.40,1.60,0.10
# Semillas por generación (1 con modelo local; 1,2,3 para barras de error)
KAIZEN_SEEDS=1,2,3
# Hilos de evaluación en paralelo (1 con un modelo local en una sola GPU)
KAIZEN_WORKERS=8
# Lo lee la web (Next), no el backend: ponlo en web/.env.local o en el entorno del servicio si el
# Python del venv no está en backend/.venv (p. ej. en el servidor)
# KAIZEN_PYTHON=/srv/kaizen/backend/.venv/bin/python
# Proveedor del modelo: "openai" (API de pago, por defecto) o "codex" (CLI de Codex con una cuenta de ChatGPT;
# requiere `codex login`). Con codex usa sus modelos (p. ej. MODEL_AGENT=gpt-5.6-luna, MODEL_SMART=gpt-6-luna)
# KAIZEN_PROVIDER=codex
# Modelos de razonamiento (familia GPT-6) en chat/completions: con herramientas exigen reasoning_effort=none
# OPENAI_REASONING_EFFORT=none
# Tope de tokens de Codex (0 = sin tope). Protege los créditos de la cuenta
# CODEX_MAX_TOKENS=5000000
# Esfuerzo de razonamiento: agente/juez y destilador/meta-loop
# CODEX_EFFORT=low
# CODEX_EFFORT_SMART=medium
# Gastar menos: "reducido" evalúa 50 de 120 tareas (5 held-out + 5 train por familia, siempre las mismas)
# KAIZEN_TASKS=reducido
# "off" apaga el juez LLM (~1/3 de las llamadas). La métrica oficial (verificador) no cambia
# KAIZEN_JUDGE=off
# Lo lee la web: clave para correr, cancelar y reset desde la interfaz (sin ella se permiten, solo para local)
# KAIZEN_ADMIN_KEY=una-clave-larga
